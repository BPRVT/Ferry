<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable section header for the Settings screen.
     NOTE: the root must NOT declare its own android:id. Each <include> of this
     layout supplies its own id (header_display, header_protocols, ...); if the
     root had an id, Android would ignore the include's id and every header would
     collide on one id, so findViewById(R.id.header_*) would return null.

     A top border rather than a bottom margin: the rule is what separates settings
     groups, matching the section rules on Home. -->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Ferry.Text.Section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="28dp"
    android:layout_marginBottom="10dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:background="@drawable/bg_section_rule" />
