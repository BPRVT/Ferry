<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — root layout for MainActivity.

    ┌────────────┬──────────────────────────────────────────┐
    │ FERRY      │                                          │
    │ ══════════ │                                          │
    │ ▌HOME      │   CONTENT (fragment container)           │
    │  SETTINGS  │                                          │
    │            │                                          │
    │ AIRPLAY RX │  ← rail footer: says what this thing is  │
    └────────────┴──────────────────────────────────────────┘

    The rail is ground-coloured and separated from content by a single hairline;
    there is no panel fill and no elevation anywhere in this UI. Ids are load-
    bearing — MainActivity.bindViews() resolves nav_item_home, nav_item_settings,
    content_container and streaming_container by id.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- ── Navigation rail ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/nav_panel"
        android:layout_width="228dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/nav_panel_background"
        android:paddingTop="40dp"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Wordmark. Wide tracking is the one piece of styling that says
             "this is the brand" without needing a logo asset. -->
        <TextView
            android:id="@+id/nav_app_name"
            style="@style/Ferry.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:textSize="26sp"
            android:text="@string/app_name" />

        <!-- Rule under the wordmark, in the accent -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            android:background="@color/accent_blue" />

        <TextView
            android:id="@+id/nav_item_home"
            style="@style/Ferry.Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:textSize="16sp"
            android:text="@string/nav_home"
            android:textColor="@color/nav_item_text"
            android:background="@drawable/nav_item_selector"
            android:focusable="true"
            android:nextFocusDown="@id/nav_item_settings"
            android:nextFocusRight="@id/content_container" />

        <TextView
            android:id="@+id/nav_item_settings"
            style="@style/Ferry.Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:textSize="16sp"
            android:text="@string/nav_settings"
            android:textColor="@color/nav_item_text"
            android:background="@drawable/nav_item_selector"
            android:focusable="true"
            android:nextFocusUp="@id/nav_item_home"
            android:nextFocusRight="@id/content_container" />

        <!-- Spacer pushes the footer to the bottom of the rail -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/Ferry.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:text="@string/rail_footer" />

    </LinearLayout>

    <!-- Hairline between rail and content -->
    <View
        android:id="@+id/nav_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/nav_panel" />

    <!-- ── Content area (fragments swap here) ─────────────────────────── -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/nav_divider"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Full-screen streaming overlay (GONE when idle) ─────────────── -->
    <FrameLayout
        android:id="@+id/streaming_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
