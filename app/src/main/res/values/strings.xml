<?xml version="1.0" encoding="utf-8"?>
<!--
    strings.xml — English (base locale)

    ALL user-visible strings MUST be defined here (i18n RULE: never hardcode strings in Kotlin/XML).
    To add a new language, create res/values-XX/strings.xml with the same keys.
    Keys that are identical across all languages can be omitted in the locale-specific file.
-->
<resources>

    <!-- ── App-wide ────────────────────────────────────────────── -->
    <string name="app_name">Ferry</string>

    <!-- ── Navigation ──────────────────────────────────────────── -->
    <string name="nav_home">Home</string>
    <string name="nav_settings">Settings</string>
    <!-- Footer at the bottom of the nav rail: states what the app is. Kept short
         enough to fit the 228dp rail at 13sp with 0.12 tracking. -->
    <string name="rail_footer">AirPlay receiver</string>

    <!-- ── Toggle readouts ─────────────────────────────────────────
         Bracketed because they replace a switch widget; the brackets are what
         signal "this is a control" now that there is no thumb to slide. -->
    <string name="toggle_on">[ ON ]</string>
    <string name="toggle_off">[ OFF ]</string>

    <!-- ── HomeFragment ────────────────────────────────────────── -->
    <string name="home_title">Ready for connections</string>
    <!-- %1$s = device name shown in sender pickers -->
    <string name="home_device_visible_as">Visible as: %1$s</string>
    <!-- %1$s = versionName, which carries the flavor suffix (e.g. "2.0.0-firetv") -->
    <string name="home_version">v%1$s</string>

    <!-- ── Protocol names ──────────────────────────────────────── -->
    <string name="protocol_airplay">AirPlay</string>
    <string name="protocol_miracast">Miracast</string>
    <string name="protocol_cast">Cast</string>

    <!-- ── Protocol states (shown in status cards) ─────────────── -->
    <string name="protocol_state_disabled">Disabled</string>
    <string name="protocol_state_advertising">Advertising</string>
    <string name="protocol_state_connected">Connected</string>
    <string name="protocol_state_error">Error</string>

    <!-- ── Protocol card detail lines ──────────────────────────── -->
    <string name="protocol_detail_disabled">Enable in Settings</string>
    <string name="protocol_detail_waiting">Waiting for sender…</string>
    <!-- %1$s = sender display name -->
    <string name="protocol_detail_connected">Streaming from %1$s</string>
    <string name="protocol_detail_error">Check Wi-Fi settings</string>

    <!-- ── Service states (header badge) ───────────────────────── -->
    <string name="service_state_running">Running</string>
    <string name="service_state_stopped">Stopped</string>
    <string name="service_state_restarting">Restarting…</string>
    <string name="service_state_error">Error</string>
    <string name="service_error_airplay">AirPlay could not start. Check Wi-Fi, then use Restart.</string>

    <!-- ── Section headers ─────────────────────────────────────── -->
    <string name="section_protocols">Protocols</string>
    <string name="section_controls">Service Control</string>

    <!-- ── Control buttons ─────────────────────────────────────── -->
    <string name="action_start">Start</string>
    <string name="action_stop">Stop</string>
    <string name="action_restart">Restart</string>

    <!-- ── Notification ────────────────────────────────────────── -->
    <string name="notification_channel_name">Ferry Service</string>
    <string name="notification_channel_description">Persistent notification for the AirPlay/Miracast/Cast receiver service</string>
    <string name="notification_status_running">Receiver active — advertising on network</string>
    <string name="notification_status_stopped">Receiver stopped</string>
    <!-- %1$s = sender device name -->
    <string name="notification_status_streaming">Streaming from %1$s</string>

    <!-- ── Settings section headers ────────────────────────────── -->
    <string name="settings_section_display">Display</string>
    <string name="settings_section_protocols">Protocols</string>
    <string name="settings_section_airplay">AirPlay</string>
    <string name="settings_section_service">Service</string>
    <string name="settings_section_developer">Developer</string>
    <string name="settings_section_about">About</string>

    <!-- ── Settings row labels ─────────────────────────────────── -->
    <string name="setting_display_name">Device Name</string>
    <string name="setting_display_name_system_default">Using system device name</string>
    <string name="setting_display_name_dialog_hint">Leave blank to use system device name</string>
    <string name="setting_display_name_reset">Reset to default</string>
    <!-- %1$s = the actual mDNS-registered name (may differ from entered name on collision) -->
    <string name="setting_display_name_collision_note">Registered as: %1$s</string>
    <string name="setting_airplay_enabled">AirPlay Receiver</string>
    <string name="setting_airplay_subtitle">Accept connections from macOS</string>
    <string name="setting_miracast_enabled">Miracast Receiver</string>
    <string name="setting_miracast_subtitle">Accept connections from Windows and Android</string>
    <string name="setting_cast_enabled">Google Cast Receiver</string>
    <string name="setting_cast_subtitle">Accept connections from Chrome and Android</string>
    <string name="setting_mirror_audio">Mirror audio</string>
    <string name="setting_mirror_audio_subtitle">Play the Mac\'s sound while mirroring</string>
    <string name="setting_pin_auth">Require pairing PIN</string>
    <string name="setting_pin_auth_subtitle">Show a code on the TV that must be entered to connect. Off = anyone on this Wi-Fi can mirror</string>
    <string name="setting_advertise_in_background">Keep receiving when closed</string>
    <string name="setting_advertise_in_background_subtitle">Stay visible to senders after you leave Ferry. Off = Ferry only receives while it is open</string>
    <string name="setting_start_on_boot">Start on boot</string>
    <string name="setting_start_on_boot_subtitle">Start receiving after the TV restarts. Implies \"Keep receiving when closed\"</string>
    <string name="setting_debug_overlay">Debug overlay</string>
    <string name="setting_debug_overlay_subtitle">Show live FPS, queue and drop stats while streaming</string>
    <string name="setting_force_high_res">Higher resolution (1440p)</string>
    <string name="setting_force_high_res_subtitle">Sharper mirroring; uses more CPU. Off = 1080p</string>
    <string name="setting_force_low_res">Smoother playback (720p)</string>
    <string name="setting_force_low_res_subtitle">Asks the sender for fewer pixels — less to send, decode and draw. Try this if video stutters. Off = 1080p</string>
    <string name="setting_force_screen_mirroring">Always mirror the screen</string>
    <string name="setting_force_screen_mirroring_subtitle">Stops apps opening their own player on the TV. Off = apps choose</string>
    <string name="setting_smart_fill">Smart fill</string>
    <string name="setting_smart_fill_subtitle">Fill the screen, trimming a little off the edges. Off = show everything with black bars</string>
    <string name="setting_audio_boost">Audio boost</string>
    <string name="setting_audio_boost_subtitle">Make quiet sources louder. Off = play at the original level</string>
    <string name="setting_audio_boost_off">Off</string>
    <string name="setting_audio_boost_value">+%1$d dB</string>
    <string name="setting_version">Version</string>
    <string name="setting_diagnostics">Diagnostics &amp; logs</string>
    <string name="setting_diagnostics_subtitle">Show the current state and recent log, with a web address to copy them from your phone</string>
    <string name="setting_reset_defaults">Reset to defaults</string>

    <!-- ── Waiting screen (legacy, used by WaitingScreen view) ─── -->
    <string name="waiting_title">Ready for AirPlay</string>
    <string name="waiting_subtitle">Open AirPlay on your Mac and select this device</string>
    <string name="waiting_device_label">This device:</string>
    <string name="streaming_hint">Press Back to stop streaming</string>

    <!-- ── Now playing (audio-only screen) ─────────────────────── -->
    <string name="now_playing_audio">Playing audio</string>
    <string name="now_playing_from">Audio from %1$s</string>

    <!-- ── Pairing PIN (access control) ─────────────────────────── -->
    <string name="pairing_pin_title">AirPlay pairing code</string>
    <string name="pairing_pin_hint">Enter this code on your device to connect</string>

    <!-- ── Error messages ──────────────────────────────────────── -->
    <string name="error_network_unavailable">No Wi-Fi connection. Please connect to Wi-Fi.</string>
    <string name="error_mdns_failed">Failed to advertise on the network.</string>
    <string name="error_wifi_p2p_unavailable">Miracast is not supported on this device.</string>
    <string name="error_cast_unavailable">Google Cast requires Google Play Services (not available on this device).</string>

    <!-- ── Accessibility ───────────────────────────────────────── -->
    <string name="content_desc_airplay_icon">AirPlay protocol icon</string>
    <string name="content_desc_miracast_icon">Miracast protocol icon</string>
    <string name="content_desc_cast_icon">Google Cast protocol icon</string>
    <string name="content_desc_status_dot">Status indicator</string>

</resources>
