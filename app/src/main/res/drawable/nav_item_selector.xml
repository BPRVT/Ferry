<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_item_selector.xml — rail items.

    Three states, each distinguishable without relying on colour alone:
      focused  → full accent block (inverted text, set in MainActivity)
      selected → accent wash + a 4dp accent bar on the leading edge, so the
                 current page is still obvious when focus has moved into content
      rest     → transparent
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_item_selected" />
        </shape>
    </item>

    <!-- Current page, focus elsewhere. The inset trick draws the leading bar:
         a full accent rectangle underneath, covered by the wash from 4dp in. -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_blue" />
                </shape>
            </item>
            <!-- Opaque, not accent_wash: a translucent layer here would let the
                 accent rectangle below show through and flood the whole cell. -->
            <item android:left="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_wash_opaque" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
