<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_destructive_selector.xml — "Reset to defaults".

    Inverts to RED rather than to the accent. The accent means "this is the thing
    you are on"; on a destructive row that reads as approval. Red on focus keeps
    the inversion language while making the row's nature unmistakable at the moment
    it is about to be pressed.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/status_stopped" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/status_stopped" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_dark" />
            <stroke android:width="1dp" android:color="@color/status_stopped" />
        </shape>
    </item>

</selector>
