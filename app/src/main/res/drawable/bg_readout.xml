<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_readout.xml — outline for non-interactive status readouts.

    Deliberately NOT focus_ring_selector: this element cannot be focused, so giving
    it the interactive cell's treatment would promise a control that isn't there.
    Ground fill + hairline, no states.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/background_dark" />
    <stroke android:width="1dp" android:color="@color/divider" />
</shape>
